#!/usr/bin/env bash
# multiverse — launcher for the multiverse monitor TUI, and setup dispatcher.
#
# Subcommands:
#   setup       Install system dependencies, sync Python deps, and report
#               Codex runtime availability.
#   update      Pull the latest changes from origin (dev-mode install only).
#   (default)   Launch the monitor TUI. Extra args forward to claude when the
#               user spawns a new session from the monitor.
#
# Previously this script wrapped a single claude process in a loop.
# That responsibility now lives in `multiverse-session`, one copy of
# which runs inside each tmux session spawned by the monitor.

set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Machine-local overrides (gitignored, never pushed). Lets a single checkout
# adapt to this host — e.g. a company-packaged claude binary and extra local
# dev plugin dirs — without editing tracked files. See bin/multiverse.local.
if [ -f "$PLUGIN_ROOT/bin/multiverse.local" ]; then
  # shellcheck disable=SC1090,SC1091
  . "$PLUGIN_ROOT/bin/multiverse.local"
fi

# Which claude binary the whole stack invokes (monitor-spawned sessions, the
# /btw fork path, and compaction). Defaults to vanilla `claude`. Exported so
# child processes (the monitor, tmux sessions, the MCP server) inherit it.
export MULTIVERSE_CLAUDE_BIN="${MULTIVERSE_CLAUDE_BIN:-claude}"
CLAUDE_BIN="$MULTIVERSE_CLAUDE_BIN"

# Codex sessions use a separate runtime adapter and plugin bundle. The plugin
# path defaults to the sibling scaffold in this repository and can be
# overridden for packaged installs or local development.
_MULTIVERSE_CODEX_BIN_WAS_SET=0
if [ -n "${MULTIVERSE_CODEX_BIN:-}" ]; then
  _MULTIVERSE_CODEX_BIN_WAS_SET=1
fi
export MULTIVERSE_CODEX_BIN="${MULTIVERSE_CODEX_BIN:-codex}"
export MULTIVERSE_CODEX_PLUGIN_ROOT="${MULTIVERSE_CODEX_PLUGIN_ROOT:-$(cd "$PLUGIN_ROOT/../plugins/multiverse-codex" 2>/dev/null && pwd || true)}"

# SecondBrain's direct spawn_agent action intentionally keeps its established
# {name, instruction?} wire payload, so runtime selection is a local wrapper policy.
# Preserve the legacy Claude default; set this to "codex" in bin/multiverse.local
# when this device should create Codex agents for direct SecondBrain spawns.
export MULTIVERSE_SECONDBRAIN_SPAWN_RUNTIME="${MULTIVERSE_SECONDBRAIN_SPAWN_RUNTIME:-claude}"

# Colon-separated extra plugin dirs loaded into interactive sessions
# (in addition to the multiverse plugin itself). Exported for the same reason.
export MULTIVERSE_EXTRA_PLUGIN_DIRS="${MULTIVERSE_EXTRA_PLUGIN_DIRS:-}"

# Rate-limit retry knobs for the underlying claude CLI. Multiverse tends to
# saturate rate limits — many active agents plus background tree-build
# workers per session, all hitting the same account. Claude's own defaults
# (10 retries, 500ms * 2^attempt exponential backoff, ~8min total) burn
# through quickly under a real traffic wave and then just fail.
#   - CLAUDE_CODE_MAX_RETRIES: raises the retry count (default 10). Only
#     takes effect during rate-limit / 5xx / connection failures; a good
#     request never touches this ceiling.
#   - CLAUDE_CODE_UNATTENDED_RETRY: enables persistent-retry mode —
#     backoff caps at 5min per attempt and total wait at 6 hours, with
#     heartbeats every 30s so the session doesn't idle out mid-wait.
#     Designed for unattended (background) sessions, exactly matching
#     tree-build workers and long-running agents. Feature-gated in the
#     claude CLI itself; harmless no-op if the build lacks the feature.
# Both propagate into every tmux-spawned session (see sessions.py's -e
# list) and every subprocess spawned by workers (natural inheritance).
export CLAUDE_CODE_MAX_RETRIES="${CLAUDE_CODE_MAX_RETRIES:-30}"
export CLAUDE_CODE_UNATTENDED_RETRY="${CLAUDE_CODE_UNATTENDED_RETRY:-1}"

# Preserve the user's original cwd so the monitor can default new
# sessions to it (uv run below will cd into the plugin root). Respect a
# pre-set value so callers that can't control the process cwd — e.g. the
# web-share ttyd child, whose cwd is the plugin root — can still scope the
# monitor to the right workspace by exporting MULTIVERSE_ORIG_CWD.
export MULTIVERSE_ORIG_CWD="${MULTIVERSE_ORIG_CWD:-$PWD}"
export MULTIVERSE_PLUGIN_ROOT="$PLUGIN_ROOT"

# Pin the multiverse state dir to one absolute path that the monitor and
# every tmux-spawned session will see. Respects a caller-set value so
# deployments that need to route this elsewhere can override.
export MULTIVERSE_ROOT="${MULTIVERSE_ROOT:-$HOME/.multiverse}"

# Snapshot/restore the user's Claude install env so multiverse works
# from any terminal — including ones that haven't sourced activate.sh
# or run an `alexcc`-style alias to set CLAUDE_CONFIG_DIR. Without this,
# starting a session in (say) VSCode and trying to resume it from iTerm2
# fails: the dashboard looks at ~/.claude/projects (default) instead of
# the actual transcript dir under $CLAUDE_CONFIG_DIR/projects, so it
# can't even see the dormant session — and even if it could, the inner
# `claude --resume <uuid>` would miss the JSONL for the same reason.
#
# Strategy:
#   - If the snapshot file exists and the current shell has none of
#     CLAUDE_CONFIG_DIR / CLAUDE_LOCAL_DATA_DIR set AND `claude` is not
#     on PATH, restore from the snapshot (fully unconfigured shell).
#   - Then, if the effective env now identifies a Claude install,
#     rewrite the snapshot from it so the file always reflects the
#     last-known-good config. Re-running multiverse from a configured
#     shell is the user's switch mechanism.
MULTIVERSE_ENV_FILE="${MULTIVERSE_ROOT}/claude-env.sh"
if [ -f "$MULTIVERSE_ENV_FILE" ] \
   && [ -z "${CLAUDE_CONFIG_DIR:-}" ] \
   && [ -z "${CLAUDE_LOCAL_DATA_DIR:-}" ] \
   && ! command -v "$CLAUDE_BIN" >/dev/null 2>&1; then
  # shellcheck disable=SC1090
  . "$MULTIVERSE_ENV_FILE"
fi
if [ -n "${CLAUDE_CONFIG_DIR:-}" ] \
   || [ -n "${CLAUDE_LOCAL_DATA_DIR:-}" ] \
   || command -v "$CLAUDE_BIN" >/dev/null 2>&1; then
  mkdir -p "$MULTIVERSE_ROOT"
  MULTIVERSE_ENV_TMP="${MULTIVERSE_ENV_FILE}.$$.$RANDOM.tmp"
  if {
    echo "# Auto-saved by bin/multiverse so multiverse can resume sessions"
    echo "# from a different terminal than the one they were started in."
    echo "# Re-run \`multiverse\` from a claude-configured shell to refresh."
    [ -n "${CLAUDE_CONFIG_DIR:-}" ] \
      && printf 'export CLAUDE_CONFIG_DIR=%q\n' "$CLAUDE_CONFIG_DIR"
    [ -n "${CLAUDE_LOCAL_DATA_DIR:-}" ] \
      && printf 'export CLAUDE_LOCAL_DATA_DIR=%q\n' "$CLAUDE_LOCAL_DATA_DIR"
    if command -v "$CLAUDE_BIN" >/dev/null 2>&1; then
      printf 'export PATH=%q:"${PATH-}"\n' \
        "$(dirname "$(command -v "$CLAUDE_BIN")")"
    fi
  } > "$MULTIVERSE_ENV_TMP"; then
    mv -f "$MULTIVERSE_ENV_TMP" "$MULTIVERSE_ENV_FILE"
  else
    rm -f "$MULTIVERSE_ENV_TMP"
  fi
  unset MULTIVERSE_ENV_TMP
fi

# Snapshot/restore the user's Codex install for the same cross-terminal reason
# as the Claude environment above. CODEX_HOME controls both native session
# discovery and resume, while MULTIVERSE_CODEX_BIN plus its PATH entry ensures
# the same CLI can be launched from a terminal that has not loaded the user's
# Codex shell configuration.
#
# An explicitly supplied CODEX_HOME or MULTIVERSE_CODEX_BIN always wins. When
# neither is supplied, restore the last-known-good snapshot (if any). Launching
# once from a configured shell refreshes the snapshot and is the switch
# mechanism for a different Codex install.
MULTIVERSE_CODEX_ENV_FILE="${MULTIVERSE_ROOT}/codex-env.sh"
if [ -f "$MULTIVERSE_CODEX_ENV_FILE" ] \
   && [ -z "${CODEX_HOME:-}" ] \
   && [ "$_MULTIVERSE_CODEX_BIN_WAS_SET" -eq 0 ]; then
  # shellcheck disable=SC1090
  . "$MULTIVERSE_CODEX_ENV_FILE"
fi
if [ -n "${CODEX_HOME:-}" ] \
   || command -v "$MULTIVERSE_CODEX_BIN" >/dev/null 2>&1; then
  mkdir -p "$MULTIVERSE_ROOT"
  MULTIVERSE_CODEX_ENV_TMP="${MULTIVERSE_CODEX_ENV_FILE}.$$.$RANDOM.tmp"
  if {
    echo "# Auto-saved by bin/multiverse so multiverse can resume Codex sessions"
    echo "# from a different terminal than the one they were started in."
    echo "# Re-run \`multiverse\` from a Codex-configured shell to refresh."
    [ -n "${CODEX_HOME:-}" ] \
      && printf 'export CODEX_HOME=%q\n' "$CODEX_HOME"
    printf 'export MULTIVERSE_CODEX_BIN=%q\n' "$MULTIVERSE_CODEX_BIN"
    if command -v "$MULTIVERSE_CODEX_BIN" >/dev/null 2>&1; then
      printf 'export PATH=%q:"${PATH-}"\n' \
        "$(dirname "$(command -v "$MULTIVERSE_CODEX_BIN")")"
    fi
  } > "$MULTIVERSE_CODEX_ENV_TMP"; then
    mv -f "$MULTIVERSE_CODEX_ENV_TMP" "$MULTIVERSE_CODEX_ENV_FILE"
  else
    rm -f "$MULTIVERSE_CODEX_ENV_TMP"
  fi
  unset MULTIVERSE_CODEX_ENV_TMP
fi
unset _MULTIVERSE_CODEX_BIN_WAS_SET

# Optional: remote web-share config (the `w` action in the monitor). If
# present, source it so the monitor — and the ttyd / cloudflared it spawns,
# and the dedicated web monitor inside them — all inherit the backbone
# selection and named-tunnel settings. See docs/remote-access.md.
MULTIVERSE_WEB_ENV_FILE="${MULTIVERSE_ROOT}/web-tunnel.env"
if [ -f "$MULTIVERSE_WEB_ENV_FILE" ]; then
  # shellcheck disable=SC1090
  . "$MULTIVERSE_WEB_ENV_FILE"
fi

prompt_yes() {
  local reply
  read -r -p "$1 [y/N] " reply
  [[ "$reply" =~ ^[Yy]$ ]]
}

detect_installer() {
  if [[ "$OSTYPE" == darwin* ]]; then
    command -v brew &>/dev/null && echo "brew" || echo ""
  elif command -v apt-get &>/dev/null; then
    echo "apt"
  elif command -v dnf &>/dev/null; then
    echo "dnf"
  elif command -v pacman &>/dev/null; then
    echo "pacman"
  else
    echo ""
  fi
}

install_pkg() {
  case "$2" in
    brew)   brew install "$1" ;;
    apt)    sudo apt-get install -y "$1" ;;
    dnf)    sudo dnf install -y "$1" ;;
    pacman) sudo pacman -S --noconfirm "$1" ;;
  esac
}

report_codex_setup() {
  local codex_path codex_version effective_home
  effective_home="${CODEX_HOME:-$HOME/.codex}"

  if codex_path=$(command -v "$MULTIVERSE_CODEX_BIN" 2>/dev/null); then
    codex_version=$("$MULTIVERSE_CODEX_BIN" --version 2>&1 || true)
    codex_version=${codex_version%%$'\n'*}
    if [ -n "$codex_version" ]; then
      echo "[multiverse setup] Codex CLI OK: $codex_path ($codex_version)"
    else
      echo "[multiverse setup] Codex CLI OK: $codex_path"
    fi
  else
    echo "[multiverse setup] Codex CLI not found: '$MULTIVERSE_CODEX_BIN'." >&2
    echo "[multiverse setup]   Claude sessions remain available; install Codex or set MULTIVERSE_CODEX_BIN to enable Codex sessions." >&2
  fi
  echo "[multiverse setup] Codex home: $effective_home"

  local missing=() rel
  for rel in \
    .codex-plugin/plugin.json \
    .mcp.json \
    hooks/hooks.json; do
    if [ ! -r "$MULTIVERSE_CODEX_PLUGIN_ROOT/$rel" ]; then
      missing+=("$rel")
    elif ! jq empty "$MULTIVERSE_CODEX_PLUGIN_ROOT/$rel" >/dev/null 2>&1; then
      missing+=("$rel (invalid JSON)")
    fi
  done
  for rel in scripts/mcp-server scripts/session-hook.py; do
    [ -x "$MULTIVERSE_CODEX_PLUGIN_ROOT/$rel" ] || missing+=("$rel (not executable)")
  done

  if [ "${#missing[@]}" -eq 0 ]; then
    echo "[multiverse setup] Codex plugin bundle OK: $MULTIVERSE_CODEX_PLUGIN_ROOT"
  else
    echo "[multiverse setup] Codex plugin bundle incomplete: $MULTIVERSE_CODEX_PLUGIN_ROOT" >&2
    printf '[multiverse setup]   Missing: %s\n' "${missing[@]}" >&2
    echo "[multiverse setup]   Claude sessions remain available; Codex sessions will fail until the bundle is repaired." >&2
  fi
}

run_setup() {
  local installer
  installer=$(detect_installer)

  local missing=()
  for dep in tmux jq; do
    command -v "$dep" &>/dev/null || missing+=("$dep")
  done

  if [ "${#missing[@]}" -gt 0 ]; then
    if [ -z "$installer" ]; then
      echo "[multiverse setup] Missing: ${missing[*]}" >&2
      echo "[multiverse setup] No supported package manager detected (brew/apt/dnf/pacman)." >&2
      echo "[multiverse setup] Install these manually, then re-run 'multiverse setup'." >&2
      exit 1
    fi
    echo "[multiverse setup] Missing system packages: ${missing[*]}"
    echo "[multiverse setup] Will install via: $installer"
    if prompt_yes "Proceed?"; then
      for pkg in "${missing[@]}"; do
        install_pkg "$pkg" "$installer"
      done
    else
      echo "[multiverse setup] Skipped. Install ${missing[*]} manually and re-run." >&2
      exit 1
    fi
  else
    echo "[multiverse setup] System deps OK (tmux, jq)."
  fi

  if ! command -v uv &>/dev/null; then
    echo "[multiverse setup] uv is not installed."
    echo "[multiverse setup] Will run: curl -LsSf https://astral.sh/uv/install.sh | sh"
    if prompt_yes "Proceed?"; then
      curl -LsSf https://astral.sh/uv/install.sh | sh
      export PATH="$HOME/.local/bin:$PATH"
    else
      echo "[multiverse setup] Install uv manually (https://docs.astral.sh/uv/) and re-run." >&2
      exit 1
    fi
  else
    echo "[multiverse setup] uv OK."
  fi

  echo "[multiverse setup] Running 'uv sync' in $PLUGIN_ROOT..."
  (cd "$PLUGIN_ROOT" && uv sync)

  report_codex_setup

  # Optional deps for remote web sharing (the `w` action). Not required for
  # core monitor use, so advise rather than fail.
  local web_missing=()
  for dep in ttyd cloudflared; do
    command -v "$dep" &>/dev/null || web_missing+=("$dep")
  done
  if [ "${#web_missing[@]}" -gt 0 ]; then
    echo "[multiverse setup] Optional (web share, the 'w' action): missing ${web_missing[*]}."
    echo "[multiverse setup]   ttyd:        brew install ttyd   /   apt-get install ttyd"
    echo "[multiverse setup]   cloudflared: brew install cloudflared   /   https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/"
    echo "[multiverse setup]   Then see docs/remote-access.md to configure the 'w' web share."
  else
    echo "[multiverse setup] Web-share deps OK (ttyd, cloudflared)."
  fi

  echo "[multiverse setup] Done. Launch with: multiverse"
}

run_update() {
  if ! command -v git &>/dev/null; then
    echo "[multiverse update] git is required but not found." >&2
    exit 1
  fi
  if ! git -C "$PLUGIN_ROOT" rev-parse --is-inside-work-tree &>/dev/null; then
    echo "[multiverse update] $PLUGIN_ROOT is not a git working tree." >&2
    echo "[multiverse update] 'update' only works for dev-mode clones of the repo." >&2
    exit 1
  fi
  echo "[multiverse update] Pulling latest from origin..."
  git -C "$PLUGIN_ROOT" pull
  echo "[multiverse update] Done. If Python deps changed, re-run 'multiverse setup'."
}

if [ "${1:-}" = "setup" ]; then
  shift
  run_setup "$@"
  exit 0
fi

if [ "${1:-}" = "update" ]; then
  shift
  run_update "$@"
  exit 0
fi

for dep in tmux jq uv; do
  if ! command -v "$dep" &>/dev/null; then
    echo "[multiverse] Error: $dep is required but not found." >&2
    echo "[multiverse] Run 'multiverse setup' to install dependencies." >&2
    exit 1
  fi
done

cd "$PLUGIN_ROOT"
exec uv run python -m src.monitor "$@"
