#!/usr/bin/env bash
# multiverse-ask — quick-ask overlay, run inside a tmux display-popup.
#
# Bound by sessions.create_session on every multiverse tmux session:
#
#   tmux bind-key -T prefix <key> display-popup -E -w 80% -h 70% \
#     "<plugin_root>/bin/multiverse-ask '#{pane_id}' '#{session_name}'"
#
# Both arguments come from the binding, not from inside the popup: a popup's
# own #{pane_id} is the popup, so capturing without the passed-in id would
# read an empty pane.
#
# The popup inherits the tmux session environment (MULTIVERSE_ROOT and friends
# are set via `tmux new-session -e`), but PLUGIN_ROOT is derived from $0 so
# this still works when invoked by hand or from a session that predates the
# env being set.

set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export MULTIVERSE_PLUGIN_ROOT="${MULTIVERSE_PLUGIN_ROOT:-$PLUGIN_ROOT}"
export MULTIVERSE_ROOT="${MULTIVERSE_ROOT:-$HOME/.multiverse}"

# Same env snapshot bin/multiverse restores, for the same reason: the fork
# subprocess must resolve transcripts under the caller's Claude install, not
# whatever the tmux server captured at start.
MULTIVERSE_ENV_FILE="${MULTIVERSE_ROOT}/claude-env.sh"
if [ -f "$MULTIVERSE_ENV_FILE" ] \
   && [ -z "${CLAUDE_CONFIG_DIR:-}" ] \
   && [ -z "${CLAUDE_LOCAL_DATA_DIR:-}" ]; then
  # shellcheck disable=SC1090
  . "$MULTIVERSE_ENV_FILE"
fi

if ! command -v uv &>/dev/null; then
  echo "multiverse-ask: uv not found in PATH" >&2
  read -r -n 1 -s
  exit 1
fi

cd "$PLUGIN_ROOT"
exec uv run python -m src.quick_ask "$@"
