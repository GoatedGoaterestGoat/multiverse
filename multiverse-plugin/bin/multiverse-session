#!/usr/bin/env bash
# multiverse-session — inner loop that wraps ONE claude process.
#
# Launched by the multiverse monitor inside a detached tmux session.
# Responsible for: running claude, dispatching control-file actions
# (currently just resume_folded), and exiting cleanly when claude does.
#
# Required env (set by the monitor on `tmux new-session -e ...`):
#   MULTIVERSE_SESSION_ID — short id for this multiverse session
#   MULTIVERSE_CONTROL    — path to control.json for fold/resume signaling
#   MULTIVERSE_STATUS     — path to status.json (written by hook scripts)

set -euo pipefail

if ! command -v jq &>/dev/null; then
  echo "[multiverse-session] jq is required (brew install jq)" >&2
  exit 1
fi
if ! command -v claude &>/dev/null; then
  echo "[multiverse-session] claude CLI not found in PATH" >&2
  exit 1
fi

: "${MULTIVERSE_CONTROL:?multiverse-session must be launched by the monitor}"
: "${MULTIVERSE_STATUS:?multiverse-session must be launched by the monitor}"

mkdir -p "$(dirname "$MULTIVERSE_CONTROL")"

# Load the multiverse plugin into every claude invocation (dev mode).
PLUGIN_ARGS=()
if [ -n "${MULTIVERSE_PLUGIN_ROOT:-}" ]; then
  PLUGIN_ARGS=(--plugin-dir "$MULTIVERSE_PLUGIN_ROOT")
fi

# Apply the multiverse session name to every claude invocation.
NAME_ARGS=()
if [ -n "${MULTIVERSE_SESSION_NAME:-}" ]; then
  NAME_ARGS=(--name "$MULTIVERSE_SESSION_NAME")
fi

CLAUDE_ARGS=("$@")

# Resolve the canonical multiverse state dir the same way src/paths.py does:
# explicit MULTIVERSE_ROOT > grandparent of MULTIVERSE_STATUS > $HOME fallback.
# Used below to find this session's pending inbox files.
resolve_multiverse_root() {
  if [ -n "${MULTIVERSE_ROOT:-}" ]; then
    printf '%s' "$MULTIVERSE_ROOT"
  elif [ -n "${MULTIVERSE_STATUS:-}" ]; then
    printf '%s' "$(dirname "$(dirname "$(dirname "$MULTIVERSE_STATUS")")")"
  else
    printf '%s' "$HOME/.multiverse"
  fi
}

# Build a positional-arg prompt to inject into the next interactive claude
# launch if this session has pending inbox messages. claude treats a
# positional prompt as the first user message and auto-submits it on
# startup — same approach `spawn_agent` uses.
#
# Why this replaced the previous `claude -p` prime call: print mode is
# headless and can't surface permission prompts. If the model wanted to
# call a tool while processing the inbox (e.g. `message_agent` to reply),
# the call would block on permission with no way for an attached user to
# grant it, so the prime would hang and the interactive claude would
# never start. Passing the prompt as a positional arg makes the inbox
# processing happen *inside* the interactive session — permissions can
# be granted, the user can attach mid-stream, and there's only one
# claude process at a time.
build_inbox_prompt() {
  [ -z "${MULTIVERSE_SESSION_NAME:-}" ] && return 0
  [ -z "${MULTIVERSE_SESSION_CWD:-}" ] && return 0

  local mv_root inbox_dir enc count
  mv_root=$(resolve_multiverse_root)
  enc=$(printf '%s' "$MULTIVERSE_SESSION_CWD" | sed 's/[^a-zA-Z0-9]/-/g')
  inbox_dir="$mv_root/inbox/$enc/$MULTIVERSE_SESSION_NAME"
  [ -d "$inbox_dir" ] || return 0
  count=$(find "$inbox_dir" -maxdepth 1 -name '*.json' 2>/dev/null | wc -l | tr -d '[:space:]')
  [ "$count" = "0" ] && return 0

  local plural="messages"
  [ "$count" = "1" ] && plural="message"

  printf '%s' "You have $count pending inbox $plural from other agents in your workspace. They have just been delivered to your context as a <system-reminder>. Please read them and respond/act on them as appropriate — a user may attach to your session shortly to see the result."
}

# Bash 3.2 (default on macOS) errors on `"${ARR[@]}"` when ARR is empty under
# `set -u`. Use `${ARR[@]+"${ARR[@]}"}` — expand only if set — to stay safe.
while true; do
  : > "$MULTIVERSE_CONTROL"

  # If the inbox has pending messages, append a prompt as a positional arg
  # so claude auto-submits it as the first user turn after resume. This
  # replaces the old print-mode prime: print mode couldn't handle
  # interactive permission prompts, so a model trying to call any tool
  # while processing the inbox would hang the whole wrapper.
  PROMPT_ARGS=()
  INBOX_PROMPT=$(build_inbox_prompt)
  if [ -n "$INBOX_PROMPT" ]; then
    PROMPT_ARGS=("$INBOX_PROMPT")
  fi

  # Run claude as a backgrounded job so we can SIGTERM it from a watcher
  # when MULTIVERSE_CONTROL gets a control action written (e.g. by
  # context_fold). Job control is off in scripts, so claude stays in our
  # process group and shares the controlling TTY normally — no SIGTTIN.
  #
  # Why we can't rely on the PostToolUse hook to exit claude: returning
  # `{"continue":false}` from PostToolUse only sets shouldPreventContinuation
  # in claude's query loop, which ends the model's current turn and drops
  # back to the input prompt. The CLI process keeps running. Without this
  # watcher, the wrapper would block forever in `wait` after a fold.
  claude ${PLUGIN_ARGS[@]+"${PLUGIN_ARGS[@]}"} \
         ${NAME_ARGS[@]+"${NAME_ARGS[@]}"} \
         ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"} \
         ${PROMPT_ARGS[@]+"${PROMPT_ARGS[@]}"} &
  CLAUDE_PID=$!

  ( while kill -0 "$CLAUDE_PID" 2>/dev/null; do
      sleep 0.5
      if [ -s "$MULTIVERSE_CONTROL" ]; then
        # Give claude a beat to finish writing the tool_result and run
        # any other PostToolUse hooks before terminating it.
        sleep 1
        kill -TERM "$CLAUDE_PID" 2>/dev/null || true
        exit 0
      fi
    done ) &
  WATCHER_PID=$!

  wait "$CLAUDE_PID" 2>/dev/null || true
  kill "$WATCHER_PID" 2>/dev/null || true
  wait "$WATCHER_PID" 2>/dev/null || true

  if [ ! -s "$MULTIVERSE_CONTROL" ]; then
    break
  fi

  ACTION=$(jq -r '.action // empty' "$MULTIVERSE_CONTROL" 2>/dev/null || true)
  [ -z "$ACTION" ] && break

  case "$ACTION" in
    resume_folded)
      NEW_SESSION=$(jq -r '.new_session_id' "$MULTIVERSE_CONTROL")
      echo ""
      echo "[multiverse] Context folded. Resuming with optimized context..."
      echo ""
      # Silence + clear, same reasoning as prime_inbox_if_needed.
      claude ${PLUGIN_ARGS[@]+"${PLUGIN_ARGS[@]}"} \
             ${NAME_ARGS[@]+"${NAME_ARGS[@]}"} \
             -p "Context was folded successfully. Continue with your current task." \
             --resume "$NEW_SESSION" >/dev/null 2>&1 || true
      clear || true
      CLAUDE_ARGS=(--resume "$NEW_SESSION")
      ;;
    *)
      echo "[multiverse-session] Unknown action: $ACTION" >&2
      break
      ;;
  esac
done

# Mark ended so the monitor can reap this entry.
if [ -n "${MULTIVERSE_STATUS:-}" ]; then
  TS=$(date +%s)
  printf '{"status":"ended","ts":%d}\n' "$TS" > "$MULTIVERSE_STATUS" || true
fi
