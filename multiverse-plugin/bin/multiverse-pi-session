#!/usr/bin/env bash
# multiverse-pi-session — inner runner for one managed pi session.

set -euo pipefail

PI_BIN="${MULTIVERSE_PI_BIN:-pi}"
: "${MULTIVERSE_STATUS:?multiverse-pi-session must be launched by the monitor}"
: "${MULTIVERSE_PLUGIN_ROOT:?MULTIVERSE_PLUGIN_ROOT is required}"

if ! command -v "$PI_BIN" >/dev/null 2>&1; then
  echo "[multiverse-pi-session] '$PI_BIN' CLI not found in PATH" >&2
  exit 1
fi

# Publish proof of life while this runtime runs, so a dashboard on another
# remote can tell "alive over there" from "that machine is gone". Only a
# machine that can see the session may vouch for it, and a wrapper is the
# session — this covers the case no dashboard here does: a remote with no
# dashboard open, or one open for a different workspace, while liveness
# correction on every OTHER remote sweeps this session regardless of cwd.
# No EXIT trap: these wrappers already install their own teardown traps, and a
# second one would silently replace the first. The writer stops itself instead,
# by noticing it has been re-parented once this wrapper is gone.
# Best-effort: a missing python or script must never stop a session starting.
_MV_HEARTBEAT_SCRIPT="${MULTIVERSE_PLUGIN_ROOT:-}/scripts/heartbeat.py"
if [ -f "$_MV_HEARTBEAT_SCRIPT" ]; then
  _MV_HEARTBEAT_PYTHON="${MULTIVERSE_PLUGIN_ROOT:-}/.venv/bin/python"
  if [ ! -x "$_MV_HEARTBEAT_PYTHON" ]; then
    _MV_HEARTBEAT_PYTHON=$(command -v python3 || true)
  fi
  if [ -n "$_MV_HEARTBEAT_PYTHON" ]; then
    # stdout/stderr closed: a background child holding the wrapper's pipes
    # open keeps anything waiting on them blocked until the runtime exits.
    "$_MV_HEARTBEAT_PYTHON" "$_MV_HEARTBEAT_SCRIPT" \
      "$(dirname "$MULTIVERSE_STATUS")" >/dev/null 2>&1 &
  fi
fi

EXTENSION="$MULTIVERSE_PLUGIN_ROOT/pi-extension/index.ts"
if [ ! -r "$EXTENSION" ]; then
  echo "[multiverse-pi-session] pi extension not found: $EXTENSION" >&2
  exit 1
fi

PI_ARGS=(--extension "$EXTENSION")
if [ -n "${MULTIVERSE_SESSION_NAME:-}" ]; then
  PI_ARGS+=(--name "$MULTIVERSE_SESSION_NAME")
fi
PI_ARGS+=("$@")

# spawn_agent hands the initial instruction through a file so long/multiline
# prompts never cross a shell re-parse boundary. pi accepts it as the final
# positional argument and submits it after session_start.
if [ -n "${MULTIVERSE_INITIAL_PROMPT_FILE:-}" ] \
   && [ -f "$MULTIVERSE_INITIAL_PROMPT_FILE" ]; then
  PI_ARGS+=("$(< "$MULTIVERSE_INITIAL_PROMPT_FILE")")
  rm -f "$MULTIVERSE_INITIAL_PROMPT_FILE" 2>/dev/null || true
  unset MULTIVERSE_INITIAL_PROMPT_FILE
fi

"$PI_BIN" "${PI_ARGS[@]}" || true

# session_shutdown normally clears the live-consumer capability and writes
# ended through the extension. Keep runner fallbacks for crashes or extension
# API changes. tmux starts this runner with -c <workspace>, so both branches
# must run from the plugin root: `-m src.mvctl` resolves `src` off cwd, and the
# workspace may well have a `src/` package of its own that we must never import.
if [ -x "$MULTIVERSE_PLUGIN_ROOT/.venv/bin/python" ]; then
  (
    cd "$MULTIVERSE_PLUGIN_ROOT"
    "$MULTIVERSE_PLUGIN_ROOT/.venv/bin/python" -m src.mvctl \
      clear-pi-prompt-consumer || true
    "$MULTIVERSE_PLUGIN_ROOT/.venv/bin/python" -m src.mvctl status ended
  ) >/dev/null 2>&1 || true
elif command -v uv >/dev/null 2>&1; then
  uv --directory "$MULTIVERSE_PLUGIN_ROOT" run --no-sync python -m src.mvctl \
    clear-pi-prompt-consumer >/dev/null 2>&1 || true
  uv --directory "$MULTIVERSE_PLUGIN_ROOT" run --no-sync python -m src.mvctl \
    status ended >/dev/null 2>&1 || true
fi
