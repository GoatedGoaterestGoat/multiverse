{
  "schema": 1,
  "name": "compaction",
  "version": "1.0.0",
  "description": "Tree compaction: per-turn summary trees in place of a harness's own summary",
  "api": "1.4",
  "module": "plugin",
  "default": "off",
  "extends": [
    "launch",
    "capabilities",
    "usage",
    "doctor",
    "cli",
    "dashboard.key",
    "dashboard.screen",
    "statusline"
  ],
  "permissions": [
    "harness.claude"
  ],
  "commands": {
    "compaction": "Show or set an agent's compaction: scheduler, summary trees, recent errors"
  },
  "statusline": {
    "compaction": {
      "claude": true,
      "tmux": false
    }
  },
  "harnesses": {
    "claude": [
      {
        "dir": "claude",
        "needs_bridge": true
      }
    ]
  },
  "settings": {
    "version": 1,
    "legacy": "compaction.json"
  }
}
