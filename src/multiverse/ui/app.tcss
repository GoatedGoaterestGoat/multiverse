Screen { background: $mv-crust; color: $mv-text; }
#masthead { height: 1; padding: 0 1; background: $mv-mantle; }
#brand { width: 1fr; color: $mv-teal; text-style: bold; }
#totals { width: auto; color: $mv-subtext0; }
#breadcrumb { display: none; height: 1; padding: 0 1; color: $mv-blue; background: $mv-mantle; }
#breadcrumb:hover { background: $mv-cursor; }
#local-view { display: none; width: 48%; height: 1fr; padding: 0 1; border-left: solid $mv-surface1; scrollbar-size: 1 1; }
#local-view.populated { display: block; }
.inspecting #local-view { display: none; }
.view-title { height: auto; margin-top: 1; color: $mv-teal; text-style: bold; }
#local-view Markdown { margin: 0; padding: 0; height: auto; }
.view-table { margin-top: 1; scrollbar-size: 1 1; }
.artifact-button { width: 100%; height: auto; min-height: 1; margin-top: 1; border: none; background: $mv-field; text-align: left; }
.artifact-description { height: auto; color: $mv-subtext0; }
#filter { display: none; height: 1; border: none; padding: 0 1; background: $mv-field; }
#filter:focus { border: none; }
#body { height: 1fr; }
#fleet { width: 1fr; height: 1fr; min-height: 3; }
#agents { height: 1fr; background: $mv-crust; scrollbar-size: 1 1; }
DataTable > .datatable--header { background: $mv-mantle; color: $mv-overlay1; text-style: none; }
DataTable > .datatable--cursor { background: $mv-cursor; color: $mv-text; text-style: bold; }
DataTable:focus > .datatable--cursor { background: $mv-cursor-focus; color: $mv-text; }
#empty { height: auto; padding: 1 2; color: $mv-overlay2; }
#selection { height: 1; padding: 0 1; color: $mv-overlay2; background: $mv-mantle; }
#status { display: none; height: 1; padding: 0 1; color: $mv-subtext0; }
#status.error { color: $mv-red; }
Footer { background: $mv-mantle; }
.drafting Footer { display: none; }
#harness-menu {
    display: none;
    position: absolute;
    overlay: screen;
    constrain: inside inside;
    border: round $mv-surface1;
    padding: 0;
    background: $mv-field;
    color: $mv-text;
    scrollbar-size: 1 1;
}
#harness-menu > .option-list--option { padding: 0 1; }
#harness-menu > .option-list--option-highlighted { background: $mv-cursor-focus; color: $mv-teal; text-style: bold; }
#inspector { display: none; width: 40%; max-width: 64; height: 1fr; padding: 0 1; border-left: solid $mv-surface1; background: $mv-mantle; }
.inspecting #inspector { display: block; }
#inspect-name { height: 1; }
#inspect-meta { height: 1; color: $mv-overlay1; }
#inspect-state { height: auto; max-height: 10; color: $mv-subtext0; }
#inspect-label { height: 1; margin-top: 1; color: $mv-overlay1; }
#inspect-work { height: auto; max-height: 4; color: $mv-text; }
#inspect-group { height: 1fr; margin-top: 1; }
#pane-scroll {
    height: 1fr;
    min-height: 4;
    margin-top: 1;
    padding: 0 1;
    border: round $mv-surface1;
    border-title-color: $mv-overlay2;
    border-title-style: none;
    scrollbar-size: 1 1;
}
#preview { height: auto; color: $mv-subtext0; }
#inspect-hint { height: 1; color: $mv-overlay1; }
.drawer #body { layout: vertical; }
.drawer #local-view { width: 100%; height: 45%; border-left: none; border-top: solid $mv-surface1; }
.drawer #inspector { width: 100%; max-width: 100%; height: 12; max-height: 60%; border-left: none; border-top: solid $mv-surface1; }
.drawer #inspect-label { display: none; }
.drawer #inspect-meta { display: none; }
.drawer #inspect-state { max-height: 5; }
.drawer #inspect-work { max-height: 2; }
.drawer #pane-scroll { margin-top: 0; }
.short.drawer #inspect-work { max-height: 1; }
.drawer #inspect-group { margin-top: 0; }
.narrow #totals { width: auto; }
Form, Choice, Details, ArtifactPreview, PluginsScreen { align: center middle; background: $mv-crust 75%; }
#dialog { width: 72; max-width: 94%; height: auto; max-height: 90%; border: round $mv-teal; background: $mv-base; padding: 1 2; }
#dialog-title { text-style: bold; height: auto; margin-bottom: 1; }
#dialog-description { height: auto; color: $mv-subtext0; margin-bottom: 1; }
#form-fields { height: auto; max-height: 24; scrollbar-size: 1 1; }
#form-fields Label { height: 1; color: $mv-subtext0; }
#form-fields Input { height: 3; margin-bottom: 1; }
.multiline { height: 7; border: round $mv-surface1; margin-bottom: 1; }
.multiline:focus { border: round $mv-teal; }
#form-error { height: auto; color: $mv-red; }
#choices { height: auto; max-height: 12; border: none; background: $mv-base; padding: 0; }
#choices > .option-list--option-highlighted { background: $mv-cursor-focus; color: $mv-teal; text-style: bold; }
.short #dialog { padding: 0 1; }
.short #dialog-title { margin-bottom: 0; }
.short #form-fields { max-height: 50vh; }
#details-dialog { width: 85%; height: 85%; border: round $mv-teal; background: $mv-base; padding: 0 1; }
.detail-title { text-style: bold; height: 2; }
#full-details { height: 1fr; scrollbar-size: 1 1; }
#full-details Static { height: auto; }
#plugins-dialog { width: 92%; max-width: 100; height: 92%; border: round $mv-teal; background: $mv-base; padding: 0 1; }
#plugins-dialog .detail-title { height: 1; }
#plugins-table { height: auto; max-height: 50%; }
#plugin-about { height: 1fr; margin-top: 1; scrollbar-size: 1 1; }
#plugin-details { height: auto; color: $mv-subtext0; }
#plugin-settings-problem { height: auto; color: $mv-red; text-style: bold; margin-bottom: 1; }
#plugin-settings-body { height: 1fr; scrollbar-size: 1 1; }
#inspect-plugins { height: auto; max-height: 4; color: $mv-subtext0; }
#inspect-plugins { display: none; }
.view-error { height: auto; color: $mv-red; padding: 0 1; }
