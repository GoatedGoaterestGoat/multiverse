#!/usr/bin/env python3
import os
import sys
from pathlib import Path

project = Path(__file__).resolve().parents[1]
# The checkout launcher uses its own environment after `uv sync`.
local_python = project / ".venv" / "bin" / "python"
if local_python.is_file() and Path(sys.prefix).resolve() != (project / ".venv").resolve():
    os.execv(str(local_python), [str(local_python), str(Path(__file__).resolve()), *sys.argv[1:]])
sys.path.insert(0, str(project / "src"))
from multiverse.cli import main

main()
